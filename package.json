{
  "name": "librariapro-typescript",
  "version": "2.0.0",
  "description": "Library Management System - Full-Stack TypeScript College Mini Project (100 Marks)",
  "main": "dist/server/server.js",
  "scripts": {
    "build:client": "npx esbuild src/client/app.ts --bundle --target=es2020 --outfile=web/app.js",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server.js",
    "dev": "npm run build:client && npx tsx src/server/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadityaa-gupta/Mini-Project.git"
  },
  "keywords": ["typescript", "library-management", "college-project", "express", "sql"],
  "author": "Aditya",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/aadityaa-gupta/Mini-Project/issues"
  },
  "homepage": "https://github.com/aadityaa-gupta/Mini-Project#readme",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
